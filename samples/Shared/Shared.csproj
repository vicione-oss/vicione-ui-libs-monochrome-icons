<Project Sdk="Microsoft.NET.Sdk.Razor">

  <ItemGroup>
    <PackageReference Include="AspNetCore.SassCompiler" />
    <PackageReference Include="ViciOne.Ui.Blazor.Components" />
    <PackageReference Include="ViciOne.Ui.Design">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="ViciOne.Ui.MonochromeIcons.Assets">
      <!-- avoids include of CSS isolation bundle -->
      <PrivateAssets>all</PrivateAssets>
      <!-- don't depend on assembly at runtime -->
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="ViciOne.Ui.MonochromeIcons.Components" />
    <PackageReference Include="ViciOne.Ui.MonochromeIcons.Core" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="sasscompiler.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ConfigureMonochromeIcons" BeforeTargets="BeforeMonochromeIconTargets">
    <ItemGroup>
      <MonochromeIcon Include="@(MonochromeIconName)" Size="@(MonochromeIconSize)" />
    </ItemGroup>

    <PropertyGroup>
      <MonochromeIconSvgOutputFolder>$(MSBuildProjectDirectory)/wwwroot/icons/monochrome-icons</MonochromeIconSvgOutputFolder>
      <MonochromeIconScssOutputFolder>$(MSBuildProjectDirectory)/Styles/icons/monochrome-icons</MonochromeIconScssOutputFolder>
    </PropertyGroup>
  </Target>

  <Target Name="CreateMonochromeIconVariablesGeneratedDuplicate" BeforeTargets="AfterMonochromeIconTargets">
    <Copy SourceFiles="$(MonochromeIconScssOutputFolder)/_variables.generated.scss" DestinationFiles="$(MonochromeIconScssOutputFolder)/_variables.generated.duplicate.scss" />
  </Target>

  <Target Name="ConfigureDesignTargets" BeforeTargets="BeforeDesignTargets">
    <PropertyGroup>
      <ColorsScssOutputFolder>$(MSBuildProjectDirectory)/Styles/design/colors</ColorsScssOutputFolder>
      <ScrollbarScssOutputFolder>$(MSBuildProjectDirectory)/Styles/design/scrollbar</ScrollbarScssOutputFolder>
    </PropertyGroup>
  </Target>

</Project>
