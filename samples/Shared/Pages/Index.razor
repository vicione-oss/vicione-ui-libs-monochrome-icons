@page "/"
@using ViciOne.Ui.Blazor.Components.Extensions
@using ViciOne.Ui.MonochromeIcons.Components

<div class="gallery">
    @foreach (var iconName in _currentIcons)
    {
        <div class="gallery-item @(GalleryOptions.AreIconsColored ? "with-color" : null)">
            <MonochromeIcon CssClass="@(GalleryOptions.IsIconOutlineActive ? "icon-outline" : null)"
                            Name="@iconName"
                            Size="@GalleryOptions.IconSize" />

            <div class="separator"></div>
            <span>@iconName.GetName().ToDashCase()</span>
        </div>
    }
</div>
