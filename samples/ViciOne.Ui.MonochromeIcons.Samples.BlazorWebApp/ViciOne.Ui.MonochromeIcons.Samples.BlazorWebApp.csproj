<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      Strangely, 'dotnet pack' executed in solution root includes this project even though 'IsPackable' is set to false
      in Directory.Build.props, which results in a warning. We suppress the warning with the following property.
    -->
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
  </PropertyGroup>

  <PropertyGroup>
    <IsPublishable>true</IsPublishable>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ViciOne.Ui.MonochromeIcons.Samples.Shared\ViciOne.Ui.MonochromeIcons.Samples.Shared.csproj" />
    <ProjectReference Include="..\ViciOne.Ui.MonochromeIcons.Samples.BlazorWebApp.WebAssemblyHost\ViciOne.Ui.MonochromeIcons.Samples.BlazorWebApp.WebAssemblyHost.csproj" />
  </ItemGroup>

</Project>
