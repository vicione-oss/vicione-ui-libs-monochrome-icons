@using ViciOne.Ui.MonochromeIcons.Samples.Shared.Models
@using ViciOne.Ui.Blazor.Components.SearchBox
@using ViciOne.Ui.Blazor.Components.Switch
@using ViciOne.Ui.MonochromeIcons.Core.Enums
@using ViciOne.Ui.MonochromeIcons.Core.Extensions
@using ViciOne.Ui.MonochromeIcons.Core.Factories

<h1>Monochrome Icons</h1>

<div class="header-bar">
    <div class="header-section separator">
        <label>Style</label>
        <div class="section-content-container">
            @foreach (var iconStyle in Enum.GetValues<IconStyle>())
            {
                <button class="select-button @(Filter.Styles.Contains(iconStyle) ? "selected" : null)"
                        @onclick="@(() => Filter.Toggle(iconStyle))">
                    @iconStyle
                </button>
            }
        </div>
    </div>

    <div class="header-section separator">
        <label for="iconSize">Size</label>
        <div class="section-content-container">
            @foreach (var iconSize in TypeSafeEnumFactory<MonochromeIconSize>.CreateAll())
            {
                <button class="select-button @(Filter.Sizes.Contains(iconSize) ? "selected" : null)"
                        @onclick="@(() => Filter.Toggle(iconSize))">
                    @string.Format("{0} {1}x{1}", iconSize, iconSize.ToPixels())
                </button>
            }
        </div>
    </div>

    <div class="header-section separator">
        <label>Filter</label>
        <div class="section-content-container">
            <SearchBox @bind-Text="@Filter.Text" @bind-Text:event="TextChanging" />
        </div>
    </div>

    <div class="header-section separator">
        <label >Show outline</label>
        <div class="section-content-container">
            <Switch @bind-Value="@Options.ShowOutline" />
        </div>
    </div>

    <div class="header-section separator">
        <label>Colored</label>
        <div class="section-content-container">
            <Switch @bind-Value="@Options.Colored" />
        </div>
    </div>

    <div class="header-section separator">
        <label>With text</label>
        <div class="section-content-container">
            <Switch @bind-Value="@Options.WithText" />
        </div>
    </div>

    <div class="header-section">
        <label>Use SVG Markup</label>
        <div class="section-content-container">
            <Switch @bind-Value="@Options.UseSvgMarkup" />
        </div>
    </div>
</div>
