<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- https://github.com/koenvzeijl/AspNetCore.SassCompiler/issues/160#issuecomment-2464275724 -->
    <SassCompilerEnableWatcher>false</SassCompilerEnableWatcher>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.SassCompiler" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <ProjectReference Include="..\ViciOne.Ui.MonochromeIcons.Core\ViciOne.Ui.MonochromeIcons.Core.csproj" />
  </ItemGroup>

  <!-- Import from targets -->
  <Import Project="Targets\GenerateCssClasses.targets" />
  <Import Project="Targets\AdjustCssBundle.targets" />

  <PropertyGroup>
    <TempDir>obj\$(Configuration)\$(TargetFramework)\TempSanitizeSvg</TempDir>
    <SketchIncomingDir>Sketch.Incoming</SketchIncomingDir>
    <SketchOriginalDir>Sketch.Original</SketchOriginalDir>
    <SketchSanitizedDir>Sketch.Sanitized</SketchSanitizedDir>
    <VerifySanitizeDir>obj\$(Configuration)\$(TargetFramework)\VerifySanitizeSvg</VerifySanitizeDir>

    <ShouldVerifySanitizedSvgs>true</ShouldVerifySanitizedSvgs>
  </PropertyGroup>

  <!-- Create a temporary directory -->
  <Target Name="CreateTempDirectory" BeforeTargets="CopySketchIncomingToTempDirectory">
    <MakeDir Directories="$(TempDir)" />
    <Message Text="Temporary directory created at $(TempDir)" Importance="high" />
  </Target>

  <!-- Copy new incoming files from folder 'Sketch.Incoming' to temporary directory -->
  <Target Name="CopySketchIncomingToTempDirectory" BeforeTargets="SanitizeSvgs">
    <ItemGroup>
      <SketchIncomingSvg Include="$(SketchIncomingDir)\*x*\**\*.svg" Exclude="$(SketchIncomingDir)\*x*\base-shape\**\*.svg" />
    </ItemGroup>

    <ItemGroup>
      <BaseShapeSvg Include="$(SketchIncomingDir)\*x*\base-shape\**\*.svg" />
    </ItemGroup>

    <ItemGroup>
      <BaseShapeSvg>
        <BaseDir>$([MSBuild]::NormalizePath(%(BaseShapeSvg.RootDir)%(BaseShapeSvg.Directory)..))</BaseDir>
      </BaseShapeSvg>
    </ItemGroup>

    <Message Text="Skip base shape: $([MSBuild]::MakeRelative(%(BaseShapeSvg.BaseDir), %(BaseShapeSvg.FullPath)))" Importance="high" Condition="Exists(%(BaseShapeSvg.Identity))" />

    <ItemGroup>
      <SketchIncomingSvg>
        <TempFileForSanitize>$(TempDir)\%(RecursiveDir)%(Filename)%(Extension)</TempFileForSanitize>
      </SketchIncomingSvg>
    </ItemGroup>

    <Message Text="Copy @(SketchIncomingSvg) to %(TempFileForSanitize)" Importance="high" Condition="Exists(%(Identity))" />

    <Copy SourceFiles="@(SketchIncomingSvg)" DestinationFiles="%(TempFileForSanitize)" Condition="Exists(%(Identity))">
      <Output TaskParameter="CopiedFiles" ItemName="_TempSvgs" />
    </Copy>
  </Target>

  <!-- Sanitize SVGs via SVGO -->
  <Target Name="SanitizeSvgs" BeforeTargets="CopySanitizedFilesToSanitizedDirectory">
    <Exec Command="npx --no-install svgo -f $(TempDir) -r" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="'@(_TempSvgs)' != ''" />
  </Target>

  <!-- Copy sanitized files from temporary directory to folder 'Sketch.Sanitized' -->
  <Target Name="CopySanitizedFilesToSanitizedDirectory" BeforeTargets="CleanWwwRootDirectory">
    <ItemGroup>
      <SketchIncomingSvg>
        <AssociatedFileInSketchSanitized>$(SketchSanitizedDir)\%(RecursiveDir)%(Filename)%(Extension)</AssociatedFileInSketchSanitized>
      </SketchIncomingSvg>
    </ItemGroup>

    <Message Text="Copy %(SketchIncomingSvg.TempFileForSanitize) to %(SketchIncomingSvg.AssociatedFileInSketchSanitized)" Importance="high" Condition="Exists(%(SketchIncomingSvg.TempFileForSanitize))" />

    <Copy SourceFiles="%(SketchIncomingSvg.TempFileForSanitize)" DestinationFiles="%(SketchIncomingSvg.AssociatedFileInSketchSanitized)" SkipUnchangedFiles="true" Condition="Exists(%(SketchIncomingSvg.TempFileForSanitize))" />
  </Target>

  <!-- Copy new svg-files from folder 'Sketch.Incoming' to folder 'Sketch.Original' -->
  <Target Name="CopySketchIncomingToSketchOriginal" BeforeTargets="SyncronizeSketchSanitizedWithSketchOriginal" Condition="Exists(@(SketchIncomingSvg))">
    <Message Text="Copy %(SketchIncomingSvg.Identity) to $(SketchOriginalDir)\%(RecursiveDir)" Importance="high" />

    <Copy SourceFiles="@(SketchIncomingSvg)" DestinationFolder="$(SketchOriginalDir)\%(RecursiveDir)" SkipUnchangedFiles="false" />
  </Target>

  <UsingTask TaskName="RemoveEmptyDirectories" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <RootPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />

      <Code Type="Fragment" Language="cs">
        <![CDATA[
        void DeleteEmptySubDirectories(string dir)
        {
          foreach (var subDir in Directory.GetDirectories(dir))
          {
            DeleteEmptySubDirectories(subDir);

            if (Directory.GetFiles(subDir).Length == 0 && Directory.GetDirectories(subDir).Length == 0)
            {
              Directory.Delete(subDir, true);
            }
          }
        }

        DeleteEmptySubDirectories(RootPath);
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- Synchronize the directory 'Sketch.Sanitized' with the directory 'Sketch.Original' -->
  <Target Name="SyncronizeSketchSanitizedWithSketchOriginal" BeforeTargets="ImportSketch" DependsOnTargets="CopySanitizedFilesToSanitizedDirectory">
    <ItemGroup>
      <FilesInSketchSanitized Include="$(SketchSanitizedDir)\**\*" />
    </ItemGroup>

    <ItemGroup>
      <FilesInSketchSanitized>
        <AssociatedFileInSketchOriginal>$(SketchOriginalDir)\%(RecursiveDir)%(Filename)%(Extension)</AssociatedFileInSketchOriginal>
      </FilesInSketchSanitized>
    </ItemGroup>

    <Message Text="Delete %(FilesInSketchSanitized.Identity) because %(FilesInSketchSanitized.AssociatedFileInSketchOriginal) does not exist" Importance="high" Condition="!Exists(%(FilesInSketchSanitized.AssociatedFileInSketchOriginal))" />
    <Delete Files="%(FilesInSketchSanitized.Identity)" Condition="!Exists(%(FilesInSketchSanitized.AssociatedFileInSketchOriginal))" />
    <RemoveEmptyDirectories RootPath="$(SketchOriginalDir)" />
    <RemoveEmptyDirectories RootPath="$(SketchSanitizedDir)" />
  </Target>

  <!--
    Verify that committed sanitized SVGs are already SVGO-optimized (idempotent)

    The target VerifySanitizedSvgs runs SVGO over a temporary copy of the committed
    Sketch.Sanitized SVGs and compares the result with the committed files. If SVGO
    would change anything, the file is not properly SVGO-sanitized and the build fails.
    This catches SVGs that were added through other issues without an initial SVGO sanitization.
  -->
  <UsingTask TaskName="VerifySvgoIdempotency" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <OriginalDir ParameterType="System.String" Required="true" />
      <VerifyDir ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />

      <Code Type="Fragment" Language="cs">
        <![CDATA[
        if (!Directory.Exists(OriginalDir))
        {
          return true;
        }

        var originalRoot = Path.GetFullPath(OriginalDir);
        var verifyRoot = Path.GetFullPath(VerifyDir);

        foreach (var originalFile in Directory.GetFiles(originalRoot, "*.svg", SearchOption.AllDirectories))
        {
          var relativePath = originalFile.Substring(originalRoot.Length).TrimStart(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
          var verifyFile = Path.Combine(verifyRoot, relativePath);

          if (!File.Exists(verifyFile))
          {
            Log.LogError($"SVGO idempotency check failed: '{relativePath}' produced no SVGO output. Ensure the SVG is SVGO-sanitized before committing it to '{OriginalDir}'.");
            continue;
          }

          var originalContent = File.ReadAllText(originalFile);
          var verifyContent = File.ReadAllText(verifyFile);

          if (!string.Equals(originalContent, verifyContent, StringComparison.Ordinal))
          {
            Log.LogError($"SVGO idempotency check failed: '{relativePath}' is not SVGO-sanitized. Run SVGO on the file and commit the optimized result to '{OriginalDir}'.");
          }
        }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- Copy committed sanitized SVGs to the verify directory and carry them to VerifySanitizedSvgs -->
  <Target Name="CopySanitizedSvgsForVerification" BeforeTargets="VerifySanitizedSvgs" DependsOnTargets="CopySanitizedFilesToSanitizedDirectory" Condition="'$(ShouldVerifySanitizedSvgs)' == 'true'">
    <ItemGroup>
      <_SanitizedSvgToVerify Include="$(SketchSanitizedDir)\**\*.svg" />
      <_SanitizedSvgToVerify>
        <VerifyFile>$(VerifySanitizeDir)\%(RecursiveDir)%(Filename)%(Extension)</VerifyFile>
      </_SanitizedSvgToVerify>
    </ItemGroup>

    <RemoveDir Directories="$(VerifySanitizeDir)" />
    <MakeDir Directories="$(VerifySanitizeDir)" />

    <Copy SourceFiles="@(_SanitizedSvgToVerify)" DestinationFiles="%(_SanitizedSvgToVerify.VerifyFile)">
      <Output TaskParameter="CopiedFiles" ItemName="_CopiedSvgToVerify" />
    </Copy>
  </Target>

  <Target Name="VerifySanitizedSvgs" BeforeTargets="ImportSketch">
    <Message Text="Verify SVGO idempotency of $(SketchSanitizedDir)" Importance="high" />

    <Exec Command="npx --no-install svgo -f $(VerifySanitizeDir) -r" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="'@(_SanitizedSvgToVerify)' != ''" />

    <VerifySvgoIdempotency OriginalDir="$(SketchSanitizedDir)" VerifyDir="$(VerifySanitizeDir)" />
  </Target>

  <!-- Delete all files from folder 'wwwroot' -->
  <Target Name="CleanWwwRootDirectory" BeforeTargets="ImportSketch">
    <ItemGroup>
      <FilesToDeleteInWwwRoot Include="wwwroot\**\*" />
    </ItemGroup>

    <Message Text="Delete %(FilesToDeleteInWwwRoot.Identity)" Importance="high" />
    <Delete Files="@(FilesToDeleteInWwwRoot)" />

    <ItemGroup>
      <Content Remove="%(FilesToDeleteInWwwRoot.Identity)" />
    </ItemGroup>
  </Target>

  <!-- Transform folder structure in 'Sketch.Sanitized' to 'wwwroot' -->
  <UsingTask TaskName="UpdateStaticWebAssetsFromSketch" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFolder ParameterType="System.String" Required="true" />
      <DestinationFolder ParameterType="System.String" Required="true" />
      <SketchSvgs ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <StaticWebAssetSvgs ParameterType="System.String[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text.RegularExpressions" />

      <Code Type="Fragment" Language="cs">
        <![CDATA[
        var staticWebAssetSvgs = new List<string>();

        var basePath = SourceFolder;
        basePath = Regex.Escape(basePath).Replace("/", @"[/\\]");
        var sketchSvgFilenames = SketchSvgs.Select(s => s.GetMetadata("FullPath"));

        foreach (var sketchSvgFilename in sketchSvgFilenames)
        {
          // https://regex101.com/r/Zrp4NI/1
          var match = Regex.Match(sketchSvgFilename, @$"{basePath}[/\\](?'size'\d+)x\1[/\\](?'name'[\w-]+)(?:[/\\](?'property'[\w-]+))*\.svg$");
          if (match.Success)
          {
            var iconSize = match.Groups["size"].Value;
            var iconName = match.Groups["name"].Value;
            var iconProperties = new List<string>();

            foreach (var iconProperty in match.Groups["property"].Captures)
              iconProperties.Add(iconProperty.ToString());

            var staticWebAssetDirectory = Path.Combine(DestinationFolder, $"{iconSize}x{iconSize}");
            var staticWebAssetSvgFilename = $"{iconName}{(iconProperties.Count > 0 ? "-" + string.Join("-", iconProperties) : string.Empty)}.svg";

            if (!Directory.Exists(staticWebAssetDirectory))
              Directory.CreateDirectory(staticWebAssetDirectory);

            var staticWebAssetSvg = Path.Combine(staticWebAssetDirectory, staticWebAssetSvgFilename);

            File.Copy(sketchSvgFilename, staticWebAssetSvg, true);

            staticWebAssetSvgs.Add(staticWebAssetSvg);
          }
          else
          {
            throw new NotSupportedException($"{sketchSvgFilename} does not match regular expression");
          }
        }

        StaticWebAssetSvgs = staticWebAssetSvgs.ToArray();
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- Call task 'UpdateStaticWebAssetsFromSketch'  -->
  <Target Name="ImportSketch" BeforeTargets="RemoveTempDirectory">
    <ItemGroup>
      <SketchSvg Include="$(SketchSanitizedDir)\**\*.svg" />
    </ItemGroup>

    <Message Text="Importing $([MSBuild]::MakeRelative($(ProjectDir), %(SketchSvg.FullPath)))" Importance="high" />

    <UpdateStaticWebAssetsFromSketch SketchSvgs="@(SketchSvg)" SourceFolder="$(SketchSanitizedDir)" DestinationFolder="$(ProjectDir)wwwroot">
      <Output PropertyName="UpdateStaticWebAssets" TaskParameter="StaticWebAssetSvgs" />
    </UpdateStaticWebAssetsFromSketch>

    <ItemGroup>
      <UpdatedStaticWebAsset Include="$(UpdateStaticWebAssets)" />
    </ItemGroup>

    <Message Text="Updated static web asset: $([MSBuild]::MakeRelative($(ProjectDir), %(UpdatedStaticWebAsset.Identity)))" Importance="high" />

    <Message Text="Updated static web asset count: @(UpdatedStaticWebAsset->Count())" Importance="high" />

    <ItemGroup>
      <!--
        Add a content item for each file in wwwwroot as @(Content) is passed to DiscoverStaticWebAssets task
        in an early stage of the build. To avoid compile error "Two assets found targeting the same path" caussed
        by already existing files in wwwwroot collected as Content items, we simply remove existing Content items
        files in target CleanWwwRootDirectory.
      -->
      <Content Include="%(UpdatedStaticWebAsset.Identity)" />
    </ItemGroup>
  </Target>

  <Target Name="CreateMonochromeIconItemsFromWwwRoot" DependsOnTargets="ImportSketch">
    <ItemGroup>
      <MonochromeIconSize Include="8" />
      <MonochromeIconSize Include="16" />
      <MonochromeIconSize Include="18" />
      <MonochromeIconSize Include="24" />
      <MonochromeIconSize Include="32" />
      <MonochromeIconSize Include="48" />
      <MonochromeIconSize Include="64" />
    </ItemGroup>

    <ItemGroup>
      <MonochromeIconName Include="@(UpdatedStaticWebAsset->Metadata('Filename'))" KeepDuplicates="false" />
    </ItemGroup>

    <ItemGroup>
      <MonochromeIcon Include="@(MonochromeIconName)" Size="@(MonochromeIconSize)" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <ResolveStaticWebAssetsInputsDependsOn>IncludeGeneratedStaticWebAsset;$(ResolveStaticWebAssetsInputsDependsOn)</ResolveStaticWebAssetsInputsDependsOn>
  </PropertyGroup>

  <Target Name="IncludeGeneratedStaticWebAsset" Outputs="%(UpdatedStaticWebAsset.Identity)" DependsOnTargets="ImportSketch" Condition="'@(UpdatedStaticWebAsset)' != ''">
    <!-- Skeleton adopted from https://github.com/dotnet/aspnetcore/blob/61e60dcf9436709a63e61da35417e2c4d30466ed/src/Components/CustomElements/src/Microsoft.AspNetCore.Components.CustomElements.csproj#L21 -->

    <PropertyGroup>
      <_UpdateStaticWebAssetsRelativePath>$([MSBuild]::MakeRelative($(ProjectDir), %(UpdatedStaticWebAsset.Identity)))</_UpdateStaticWebAssetsRelativePath>
    </PropertyGroup>

    <ItemGroup>
      <_CandidateAsset Include="%(UpdatedStaticWebAsset.Identity)" />
      <_CandidateAsset>
        <!--
           https://regex101.com/r/PZZ45o

           wwwroot\foo.js -> foo.js
        -->
        <RelativePath>$([System.Text.RegularExpressions.Regex]::Replace($(_UpdateStaticWebAssetsRelativePath), '^wwwroot[\\/](.+)', '$1'))</RelativePath>
      </_CandidateAsset>
    </ItemGroup>

    <PropertyGroup>
      <_CandidateAssetIdentity>%(_CandidateAsset.Identity)</_CandidateAssetIdentity>
    </PropertyGroup>

    <DefineStaticWebAssets SourceType="Computed" SourceId="$(PackageId)" ContentRoot="$(MSBuildProjectDirectory)\wwwroot\" BasePath="$(StaticWebAssetBasePath)" CandidateAssets="@(_CandidateAsset)">
      <Output TaskParameter="Assets" ItemName="_DefinedGeneratedStaticWebAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints CandidateAssets="@(_DefinedGeneratedStaticWebAsset)" ExistingEndpoints="@()" ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_DefinedGeneratedStaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>

    <ItemGroup>
      <StaticWebAsset Include="@(_DefinedGeneratedStaticWebAsset)" Condition="!@(StaticWebAsset-&gt;AnyHaveMetadataValue('Identity', $(_CandidateAssetIdentity)))" />
      <StaticWebAssetEndpoint Include="@(_DefinedGeneratedStaticWebAssetEndpoint)" Condition="!@(StaticWebAssetEndpoint-&gt;AnyHaveMetadataValue('Identity', $(_CandidateAssetIdentity)))" />
    </ItemGroup>
  </Target>

  <!-- Delete temporary directory -->
  <Target Name="RemoveTempDirectory" BeforeTargets="CleanIncomingDirectory">
    <Message Text="Remove $(TempDir)" Importance="high" />

    <RemoveDir Directories="$(TempDir)" />
  </Target>

  <!-- Delete sub-folders from folder 'Sketch.Incoming' -->
  <Target Name="CleanIncomingDirectory" BeforeTargets="PreBuildEvent">
    <ItemGroup>
      <SketchIncomingSubDirectory Include="$([System.IO.Directory]::GetDirectories(`$(SketchIncomingDir)`))" />
    </ItemGroup>

    <Message Text="Delete %(SketchIncomingSubDirectory.Identity) from $(SketchIncomingDir)" Importance="high" Condition="Exists(%(SketchIncomingSubDirectory.Identity))" />

    <RemoveDir Directories="%(SketchIncomingSubDirectory.Identity)" Condition="Exists(%(SketchIncomingSubDirectory.Identity))" />
  </Target>

</Project>
