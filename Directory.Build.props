<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Properties for all projects -->
  <PropertyGroup>
    <!-- General -->
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers Condition="$(MSBuildProjectDirectory.Contains('src'))">linux-x64;linux-arm64;win-x64</RuntimeIdentifiers>
    <Description>Monochrome icons for the ViciOne product family</Description>
    <Product>ViciOne Monochrome Icons</Product>
    <Company>ifm software gmbh</Company>
    <Year>$([System.DateTime]::Now.Year)</Year>
    <Copyright>Copyright © $(Company) $(Year)</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>

    <!-- Compilation -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>

    <!-- Code quality -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Enable XML documentation for all projects by default as EnforceCodeStyleInBuild relys on it, see https://github.com/dotnet/roslyn/issues/41640 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet lock file -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
  </PropertyGroup>

  <!-- Ensure locally built assemblies carry the correct version instead of the default 1.0.0.0 -->
  <PropertyGroup Condition="'$(CI)' == ''">
    <Version>$([System.IO.File]::ReadAllText('$(MsBuildThisFileDirectory)VERSION').Trim())</Version>

    <!--
      Repo specific note regarding this section:

      This repo depends on NuGet packages that also ship with a dependency on the
      Monochrome Icons packages. Without proper version info, locally built assemblies
      would look older (1.0.0.0 instead of e.g. 4.16.0) than the NuGet ones (e.g. 4.15.0),
      causing the wrong assembly to load at runtime and triggering errors.
    -->
  </PropertyGroup>

  <!-- NuGet package properties -->
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://gitlab.com/vicione-oss/vicione/ui-libs/monochrome-icons.git</PackageProjectUrl>
    <Authors>$(Company)</Authors>
  </PropertyGroup>

  <!-- Configuration for resulting NuGet package -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Add package references to projects in tests folder -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests')) Or $(MSBuildProjectName.EndsWith('TestingHelpers'))">
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>

  <!-- Configure xunit runner for test projects -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <Content Include="$(MSBuildThisFileDirectory)/tests/xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Add package references to test projects -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <!-- Configure output type according to xUnit 3 documentation for test projects -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <OutputType>Exe</OutputType>
    <IsPublishable>true</IsPublishable>

    <!-- Microsoft Testing Platform command line experience -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <!-- No XML documentation for projects not shared as NuGet package -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('samples')) Or $(MSBuildProjectDirectory.Contains('tests'))">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Make internals visible to test projects -->
  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('tests')) == false">
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
  </ItemGroup>

  <!-- Ensure executing 'dotnet pack' in solution root only packs those projects that should be released as NuGet packages -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('samples')) Or $(MSBuildProjectDirectory.Contains('tests'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Fix restore error in CI pipeline complaining about missing Microsoft package reference -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('samples'))">
    <RestoreLockedMode Condition="'$(CI)' == 'true'">false</RestoreLockedMode>
  </PropertyGroup>

</Project>
